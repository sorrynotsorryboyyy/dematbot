# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# Identifiant de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# Identifiant du serveur Discord (clic droit sur le serveur > Copier l'identifiant du serveur,
# avec le mode developpeur active dans Parametres > Avances)
GUILD_ID=
